# Servidor estático para Railway.
# Railway inyecta el puerto en la variable PORT; 8080 es solo el valor local.
{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	root * /srv
	encode gzip zstd
	file_server

	# La app es un solo archivo: cualquier ruta desconocida entrega index.html
	try_files {path} /index.html

	header {
		# Impide que el navegador sirva una versión vieja tras cada despliegue
		Cache-Control "no-cache"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
